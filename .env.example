# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Postgres connection string. Create a free database at neon.tech, then
# Connect -> turn Connection pooling off -> copy the string.
# Remove "&channel_binding=require" if it appears at the end.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Random string of 16+ characters used to sign the session cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=""
